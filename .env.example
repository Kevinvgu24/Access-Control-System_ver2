# ==============================================================================
# SMART DOOR ACCESS CONTROL - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Secret Key for signing JWT tokens (Change to a strong random 64-char string in production)
JWT_SECRET_KEY=change-this-to-a-super-secret-random-key-in-production-2026

# Device API Key for Raspberry Pi 5 / Edge Sync Client authentication
DEVICE_API_KEY=smart-door-edge-device-secret-key-2026

# Allowed CORS Origins (Comma-separated list or domain)
ALLOWED_ORIGINS=https://smartdoor.vgulabmanagement.site,http://localhost:3000,http://localhost:5000

# Flask Environment
FLASK_ENV=production
DEBUG=False
